# Supabase Postgres connection string.
# In Supabase dashboard → Project Settings → Database → Connection string,
# copy the "Session pooler" URL (port 5432) for migrations + runtime.
# (Or use the transaction pooler on 6543 if you expect high concurrency —
# the runtime client is configured with `prepare: false` so both work.)
DATABASE_URL=postgres://postgres.YOUR-PROJECT:PASSWORD@aws-0-region.pooler.supabase.com:5432/postgres

# Schema name inside Postgres dedicated to this app
DB_SCHEMA=hr_screening

# Anthropic API key used by the AI screening route
ANTHROPIC_API_KEY=sk-ant-...

# Shared password for /admin (set something long and random)
ADMIN_PASSWORD=change-me-now

# Long random string used to sign the admin session cookie
ADMIN_SESSION_SECRET=change-me-to-a-long-random-string

# --- Supabase Storage (resume PDF uploads) -----------------------------------
# Project Settings → API
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Service-role key (server-side only — NEVER expose to the browser)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...
# Private bucket name. Auto-created by the seed script if missing.
SUPABASE_BUCKET=resumes
