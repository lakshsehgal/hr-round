# Neon Postgres connection string (pooled connection recommended)
DATABASE_URL=postgres://user:password@ep-xxx.neon.tech/dbname?sslmode=require

# Schema name inside the Neon database dedicated to this app.
# Use a unique name if other projects share the same Neon database — the
# schema namespaces this app's tables so they can't collide with anything else.
DB_SCHEMA=hr_screening

# Anthropic API key used by the AI screening route
ANTHROPIC_API_KEY=sk-ant-...

# Shared password for /admin (set something long and random)
ADMIN_PASSWORD=change-me-now

# Long random string used to sign the admin session cookie
ADMIN_SESSION_SECRET=change-me-to-a-long-random-string

# Vercel Blob token for resume PDF uploads.
# Auto-injected when a Blob store is connected to the Vercel project (no
# manual setting needed in production). For local dev, copy from the Vercel
# dashboard → Storage → your Blob store → .env.local snippet.
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...
