# Neon Postgres connection string (pooled connection recommended)
DATABASE_URL=postgres://user:password@ep-xxx.neon.tech/dbname?sslmode=require

# Schema name inside the Neon database dedicated to this app
DB_SCHEMA=hr_screening

# Anthropic API key used by the AI screening route
ANTHROPIC_API_KEY=sk-ant-...

# Shared password for /admin (set something long and random)
ADMIN_PASSWORD=change-me-now

# Long random string used to sign the admin session cookie
ADMIN_SESSION_SECRET=change-me-to-a-long-random-string

# --- Supabase Storage (resume PDF uploads) -----------------------------------
# Found in Supabase dashboard → Project Settings → API
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Service-role key (server-side only — NEVER expose to the browser)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...
# Private bucket name. Auto-created by the seed / bootstrap step if missing.
SUPABASE_BUCKET=resumes
